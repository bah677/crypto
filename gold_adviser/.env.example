# =============================================================================
# gold_adviser — скопируйте в .env и заполните.
# =============================================================================

TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
SUPERADMIN_TELEGRAM_ID=123456789

# PostgreSQL — НОВАЯ БД gold_adviser, тот же user/password что у crypto_adviser
DATABASE_URL=postgresql+asyncpg://traiding_bot_ema_sub:PASSWORD@localhost:5432/gold_adviser
# или по частям:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gold_adviser
# DB_USER=traiding_bot_ema_sub
# DB_PASSWORD=

LOG_LEVEL=INFO

# Market data
REALMARKET_API_KEY=
TWELVEDATA_API_KEY=

# Bybit linear perpetual XAU (публичный kline, ключ не нужен)
BYBIT_SYMBOL=XAUUSDT
BYBIT_CATEGORY=linear

GOLD_SYMBOL=XAUUSD
GOLD_SCAN_SECOND=3
# Bybit: 2–5с после close; для Twelve Data ставили бы ~55
GOLD_SCAN_AFTER_CLOSE_SEC=3
GOLD_SCAN_POLL_SEC=5
GOLD_DEFAULT_ENABLED=1
GOLD_DEFAULT_BODY_MULT=2.0
GOLD_DEFAULT_LOOKBACK=30
GOLD_SETTINGS_CACHE_TTL_SEC=30
