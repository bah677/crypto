# =============================================================================
# Пример конфигурации. Скопируйте в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env с секретами.
# =============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
SUPERADMIN_TELEGRAM_ID=123456789

# Группа-форум для алертов (опционально). Если не задано — алерты в личку.
# TELEGRAM_ALERTS_CHAT_ID=-100xxxxxxxxxx
# TELEGRAM_ALERTS_TOPIC_SIGNALS=1
# TELEGRAM_ALERTS_TOPIC_FUNDING=2
# TELEGRAM_ALERTS_TOPIC_PRICE_SPIKE=3
# TELEGRAM_ALERTS_TOPIC_EMA_SL=4
# TELEGRAM_ALERTS_TOPIC_SL_FOLLOW=5
TELEGRAM_ALERTS_TOPIC_PUMP=870
TELEGRAM_ALERTS_TOPIC_DUMP=965

# --- Bybit ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_NETWORK=mainnet
BYBIT_CATEGORY=linear
# BYBIT_POSITION_IDX=0
# BYBIT_DEFAULT_POSITION_LOTS=0.01

# --- PostgreSQL ---
# Вариант 1: полный URL
DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/crypto_bot

# Вариант 2: по частям (если DATABASE_URL не задан)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=crypto_bot
# DB_USER=crypto_user
# DB_PASSWORD=

# --- Режим бота ---
# advisor — только сигналы в Telegram
# trading — автоторговля (Bybit + опционально MT5 на Windows)
BOT_MODE=advisor
LOG_LEVEL=INFO

# --- Pump scanner ---
PUMP_SCAN_ENABLED=1
# 1 = только pump-сканер в планировщике (без EMA advisor / funding / SL)
PUMP_ONLY_MODE=0
# 1 = pump-алерты в личку SUPERADMIN_TELEGRAM_ID
PUMP_ALERTS_TO_PRIVATE=1

# --- DeepSeek (анализ pump-алертов + entry-watch re-eval) ---
DEEPSEEK_ENABLED=1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- LunarCrush (опционально, в алертах) ---
LUNARCRUSH_ENABLED=1
LUNARCRUSH_API_KEY=

# --- Entry watch («следить до входа») ---
PUMP_ENTRY_WATCH_ENABLED=1
PUMP_ENTRY_WATCH_INTERVAL_SEC=180
PUMP_ENTRY_WATCH_LLM_COOLDOWN_SEC=3600
PUMP_ENTRY_WATCH_MAX_PER_USER=20

# --- EMA-будильники на pump-алертах ---
PUMP_EMA_ALARM_ENABLED=1
PUMP_EMA_ALARM_INTERVAL_SEC=120

# --- Прочие мониторы (выключаются при PUMP_ONLY_MODE=1) ---
FUNDING_SCAN_ENABLED=1
FUNDING_ANNUAL_THRESHOLD=5000
FUNDING_TOP_N=100

EMA_SL_MONITOR_ENABLED=1
SL_FOLLOW_MONITOR_ENABLED=1
SL_ANOM_CLOSE_MONITOR_ENABLED=1
PRICE_SPIKE_MONITOR_ENABLED=1
PRICE_SPIKE_RATIO=3.0
PRICE_SPIKE_ALERT_COOLDOWN_MIN=5

FAST_EMA_INFLECTION_ENABLED=1
ADVISOR_VOLATILITY_SPIKE_FACTOR=1.5

ATR_PULLBACK_ENABLED=1
SCALP_ADVISOR_ENABLED=1
BOT_ORDER_WATCH_ENABLED=1
BOT_ORDER_WATCH_INTERVAL_SEC=60
